internal class Program
{
    // AES setup
    private static Aes CreateAES() //method
    {
        Aes aes = Aes.Create();
        aes.KeySize = 128; // AES-128
        aes.BlockSize = 128;
        
        aes.Mode = CipherMode.CBC; // Cipher Block Chaining mode
        aes.Padding = PaddingMode.PKCS7; // Padding to fit block size
        return aes;
    }

    // Encryption method using AES
    private static string EncryptString(string plainText, byte[] key /*as 128 bits*/, byte[] iv) //constructor
    {
        using (Aes aes = CreateAES())
        {
            aes.Key = key;
            aes.IV = iv;

            ICryptoTransform encryptor = aes.CreateEncryptor(aes.Key, aes.IV);

            using (MemoryStream memory_st = new MemoryStream())
            {
                using (CryptoStream crypto_st = new CryptoStream(memory_st, encryptor, CryptoStreamMode.Write))
                {
                    using (StreamWriter stream_wr = new StreamWriter(crypto_st))
                    {
                        // Write the plain text to the stream
                        stream_wr.Write(plainText);
                    }

                    // Return encrypted data as a base64 string
                    return Convert.ToBase64String(memory_st.ToArray());
                }
            }
        }
    }
    
    // Decryption method using AES
    private static string DecryptString(string cipherText, byte[] key, byte[] iv)
    {
        using (Aes aes = CreateAES())
        {
            aes.Key = key;
            aes.IV = iv;

            ICryptoTransform decryptor = aes.CreateDecryptor(aes.Key, aes.IV);

            using (MemoryStream memory_st = new MemoryStream(Convert.FromBase64String(cipherText)))
            {
                using (CryptoStream crypto_st = new CryptoStream(memory_st, decryptor, CryptoStreamMode.Read))
                {
                    using (StreamReader stream_wr = new StreamReader(crypto_st))
                    {
                        // Read the decrypted bytes from the decrypting stream
                        return stream_wr.ReadToEnd();
                    }
                }
            }
        }
    }
    

    public static void Main(string[] args)
    {
        Console.WriteLine("Input your login please: ");
        string login = Console.ReadLine();

        Console.WriteLine("Input your password: ");
        string password = Console.ReadLine();

        // Create a new customer and perform login/password check
        Customer customer = new Customer(login, password);
        customer.Login_password_check();

        // take the checked data from Customer
        login = customer.Login;
        password = customer.Password;

        
        
        
        
        // Step 1: Generate a random key and Initialization Vector
        Aes aes = CreateAES();
        aes.GenerateKey(); // This is the encryption key
        aes.GenerateIV();  // This is the initialization vector

        byte[] key = aes.Key; // 'cipher key' 
        byte[] iv = aes.IV;   // Initial vector used in CBC mode

        // Step 2: Encrypt the login and password
        string cipheredLogin = EncryptString(login, key, iv);
        string cipheredPassword = EncryptString(password, key, iv);

        // Display the ciphered output
        Console.WriteLine("Ciphered login: " + cipheredLogin);
        Console.WriteLine("Ciphered password: " + cipheredPassword);
        
        // Step 3: Decrypt the login and password to verify
        string decryptedLogin = DecryptString(cipheredLogin, key, iv);
        string decryptedPassword = DecryptString(cipheredPassword, key, iv);

        // Display the decrypted output
        Console.WriteLine("Decrypted login: " + decryptedLogin);
        Console.WriteLine("Decrypted password: " + decryptedPassword);

        // Proof that encryption and decryption worked
        if (decryptedLogin == login && decryptedPassword == password)
        {
            Console.WriteLine("Encryption test successful.");
        }
        else
        {
            Console.WriteLine("Encryption test failed.");
        }
        
        // write a redirection to the master profile with specific ID 
    }
}


